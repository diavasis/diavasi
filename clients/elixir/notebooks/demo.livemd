# Diavasi demo

```elixir
Mix.install([
  {:kino, "~> 0.14"},
  {:req, "~> 0.5"},
  {:diavasi_bench, path: Path.expand("..", __DIR__)}
])
```

## Intro

This notebook starts `diavasi serve`, a synthetic group, and the Python and Elixir clients. The records come from the generator inside the server (`total_records`, `batch_max_records`). That generator is the producer until the PostgreSQL adapter exists. Connection rows in the control plane stay metadata until then.

Build the server first, from the repository root:

```bash
cargo build -p diavasi-cli
```

The Python client uses `clients/python/.venv` (`grpcio` installed). Open this notebook from the repo so the paths below resolve.

## Setup

```elixir
root = Path.expand("../../..", __DIR__)
bin = Path.join(root, "target/debug/diavasi")
python = Path.join(root, "clients/python/.venv/bin/python")
python_dir = Path.join(root, "clients/python")

unless File.exists?(bin) do
  raise "missing #{bin}; run `cargo build -p diavasi-cli` from the repo root"
end

unless File.exists?(python) do
  raise "missing #{python}; create the clients/python virtualenv and install grpcio"
end

token = "demo-token"
store_key = Base.encode16(:crypto.strong_rand_bytes(32), case: :lower)

free_port = fn ->
  {:ok, socket} = :gen_tcp.listen(0, [:binary, ip: {127, 0, 0, 1}, reuseaddr: true])
  {:ok, port} = :inet.port(socket)
  :gen_tcp.close(socket)
  port
end

control_port = free_port.()
data_port = free_port.()
work = Path.join(System.tmp_dir!(), "diavasi-demo-#{control_port}")
File.mkdir_p!(work)
store = Path.join(work, "meta.redb")
ca = Path.join(work, "dataplane-ca.crt")
base = "http://127.0.0.1:#{control_port}"
data_addr = "127.0.0.1:#{data_port}"

:ok
```

## Start the server

```elixir
server =
  spawn(fn ->
    port =
      Port.open({:spawn_executable, bin}, [
        :binary,
        :exit_status,
        :stderr_to_stdout,
        args: [
          "serve",
          "--bind",
          "127.0.0.1:#{control_port}",
          "--data-bind",
          data_addr,
          "--store",
          store,
          "--token",
          token,
          "--store-key",
          store_key
        ]
      ])

    loop = fn loop ->
      receive do
        {:stop, from} ->
          Port.close(port)
          send(from, :stopped)

        _other ->
          loop.(loop)
      end
    end

    loop.(loop)
  end)

deadline = System.monotonic_time(:millisecond) + 10_000

wait = fn wait ->
  case Req.get(base <> "/health", retry: false) do
    {:ok, %{status: 200}} ->
      :ok

    _ ->
      if System.monotonic_time(:millisecond) > deadline do
        raise "server did not become healthy at #{base}/health"
      else
        Process.sleep(100)
        wait.(wait)
      end
  end
end

wait.(wait)
Kino.Markdown.new("Control plane at `#{base}`. Data plane at `#{data_addr}`. CA: `#{ca}`.")
```

## Synthetic groups

Each client gets its own group so both can read the full id range. The source is the synthetic `u64` generator, not a database.

```elixir
auth = {:bearer, token}

create = fn id, total, batch ->
  body = %{
    group_id: id,
    total_records: total,
    payload_size: 4,
    max_buffer_records: 64,
    max_buffer_bytes: 1_048_576,
    batch_max_records: batch,
    batch_timeout_ms: 1_000,
    ordering_contract: "synthetic-u64",
    connection_id: nil
  }

  Req.post!(base <> "/v1/groups", auth: auth, json: body)
  Req.post!(base <> "/v1/groups/#{id}/start", auth: auth)
end

create.("py", 20, 5)
create.("ex", 20, 5)

status = Req.get!(base <> "/v1/status", auth: auth).body
py = Req.get!(base <> "/v1/groups/py", auth: auth).body
checkpoint = Req.get!(base <> "/v1/groups/py/checkpoint", auth: auth).body

Kino.Layout.grid(
  [
    Kino.Markdown.new("**Status**"),
    Kino.Inspect.new(status),
    Kino.Markdown.new("**Group `py`** (Elixir group `ex` uses the same shape)"),
    Kino.Inspect.new(py),
    Kino.Markdown.new("**Checkpoint** before any consumer"),
    Kino.Inspect.new(checkpoint)
  ],
  columns: 1
)
```

## Consume with both clients

```elixir
{:ok, elixir_ids} =
  Diavasi.Data.Client.run(
    addr: data_addr,
    ca: ca,
    token: token,
    group: "ex",
    consumer: "ex1",
    total: 20,
    max_in_flight: 2
  )

{python_out, 0} =
  System.cmd(
    python,
    [
      "-m",
      "diavasi_data",
      "--addr",
      data_addr,
      "--ca",
      ca,
      "--token",
      token,
      "--group",
      "py",
      "--consumer",
      "py1",
      "--total",
      "20",
      "--print-ids"
    ],
    cd: python_dir,
    env: [{"PYTHONPATH", python_dir}],
    stderr_to_stdout: true
  )

python_ids =
  python_out
  |> String.split("\n", trim: true)
  |> Enum.find_value([], fn line ->
    case String.split(line) do
      ["ids" | ids] -> Enum.map(ids, &String.to_integer/1)
      _ -> nil
    end
  end)

after_checkpoint = Req.get!(base <> "/v1/groups/ex/checkpoint", auth: auth).body

Kino.Layout.grid(
  [
    Kino.DataTable.new([
      %{consumer: "ex1", count: length(elixir_ids), record_ids: Enum.join(elixir_ids, " ")},
      %{consumer: "py1", count: length(python_ids), record_ids: Enum.join(python_ids, " ")}
    ]),
    Kino.Markdown.new("**Checkpoint** for group `ex` after the Elixir client left"),
    Kino.Inspect.new(after_checkpoint)
  ],
  columns: 1
)
```

## Disconnect and requeue

The first consumer acks one batch of 5, then drops the connection on the next batch without acking it. Those record ids are requeued. The second consumer reads the 15 records still outstanding, including that batch.

```elixir
create.("requeue", 20, 5)

{:ok, dropped} =
  Diavasi.Data.Client.run(
    addr: data_addr,
    ca: ca,
    token: token,
    group: "requeue",
    consumer: "drop",
    total: 20,
    max_in_flight: 1,
    halt_after: 1
  )

Process.sleep(300)

{:ok, resumed} =
  Diavasi.Data.Client.run(
    addr: data_addr,
    ca: ca,
    token: token,
    group: "requeue",
    consumer: "resume",
    total: 15,
    max_in_flight: 2
  )

requeued =
  MapSet.intersection(MapSet.new(dropped), MapSet.new(resumed))
  |> MapSet.to_list()
  |> Enum.sort()

Kino.DataTable.new([
  %{consumer: "drop", count: length(dropped), record_ids: Enum.join(dropped, " ")},
  %{consumer: "resume", count: length(resumed), record_ids: Enum.join(resumed, " ")},
  %{consumer: "requeued", count: length(requeued), record_ids: Enum.join(requeued, " ")}
])
```

## Stop

```elixir
send(server, {:stop, self()})

receive do
  :stopped -> Kino.Markdown.new("Server stopped. Store left at `#{work}`.")
after
  2_000 -> Kino.Markdown.new("Stop signal sent.")
end
```
